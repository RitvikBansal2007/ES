<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left cyan border -->
    <item android:left="0dp" android:right="2dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_cyan" />
            <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
        </shape>
    </item>
    <!-- Main card background -->
    <item android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners
                android:topRightRadius="12dp"
                android:bottomRightRadius="12dp"
                android:topLeftRadius="2dp"
                android:bottomLeftRadius="2dp" />
        </shape>
    </item>
</layer-list>
