<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ─── LOGIN ─── -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="ac.iiit.rtltutor.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <!-- Student login → Home -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />

        <!-- Admin login → Admin Panel -->
        <action
            android:id="@+id/action_login_to_admin"
            app:destination="@id/adminFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />

        <!-- → Register -->
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ─── REGISTER ─── -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="ac.iiit.rtltutor.ui.login.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <!-- After register → Home (clear stack) -->
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
    </fragment>

    <!-- ─── ADMIN PANEL ─── -->
    <fragment
        android:id="@+id/adminFragment"
        android:name="ac.iiit.rtltutor.ui.admin.AdminFragment"
        android:label="Admin"
        tools:layout="@layout/fragment_admin">

        <!-- Admin sign out → login (clear admin from stack) -->
        <action
            android:id="@+id/action_admin_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/adminFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- ─── HOME ─── -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="ac.iiit.rtltutor.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_home_to_rtl_live"
            app:destination="@id/rtlLiveViewFragment"
            app:enterAnim="@anim/slide_in_up" />
    </fragment>

    <!-- ─── CHAT ─── -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="ac.iiit.rtltutor.ui.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat" />

    <!-- ─── QUIZ ─── -->
    <fragment
        android:id="@+id/quizFragment"
        android:name="ac.iiit.rtltutor.ui.quiz.QuizFragment"
        android:label="Quiz"
        tools:layout="@layout/fragment_quiz" />

    <!-- ─── FLASHCARDS ─── -->
    <fragment
        android:id="@+id/flashcardFragment"
        android:name="ac.iiit.rtltutor.ui.flashcard.FlashcardFragment"
        android:label="Flashcards"
        tools:layout="@layout/fragment_flashcard" />

    <!-- ─── RTL LIVE ─── -->
    <fragment
        android:id="@+id/rtlLiveViewFragment"
        android:name="ac.iiit.rtltutor.ui.rtllive.RtlLiveViewFragment"
        android:label="RTL Live"
        tools:layout="@layout/fragment_rtl_live_view" />

    <!-- ─── PROGRESS ─── -->
    <fragment
        android:id="@+id/progressFragment"
        android:name="ac.iiit.rtltutor.ui.progress.ProgressFragment"
        android:label="Progress"
        tools:layout="@layout/fragment_progress" />

    <!-- ─── SETTINGS ─── -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="ac.iiit.rtltutor.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">

        <!-- Sign out → login (clear entire back stack) -->
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right" />
    </fragment>

</navigation>
