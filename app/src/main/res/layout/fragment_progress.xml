<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    tools:context=".ui.progress.ProgressFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="56dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learning Progress"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track your mastery across all dimensions"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/inter"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Bloom Mastery Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bloom_mastery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_bloom_mastery"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/space_grotesk"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Bloom Level Rows -->
                <LinearLayout
                    android:id="@+id/ll_bloom_bars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- L1 Remember -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="L1 Remember"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_1"
                            android:fontFamily="@font/inter" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="85"
                            app:trackColor="@color/bg_elevated"
                            app:indicatorColor="@color/bloom_1"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_1"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- L2 Understand -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="L2 Understand"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_2"
                            android:fontFamily="@font/inter" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="72"
                            app:trackColor="@color/bg_elevated"
                            app:indicatorColor="@color/bloom_2"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="72%"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_2"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- L3 Apply -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="L3 Apply"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_3"
                            android:fontFamily="@font/inter" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_bloom_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="55"
                            app:trackColor="@color/bg_elevated"
                            app:indicatorColor="@color/bloom_3"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/tv_bloom_3_pct"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="55%"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_3"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- L4 Analyze -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="L4 Analyze"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_4"
                            android:fontFamily="@font/inter" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="38"
                            app:trackColor="@color/bg_elevated"
                            app:indicatorColor="@color/bloom_4"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="38%"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_4"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- L5 Evaluate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="L5 Evaluate"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_5"
                            android:fontFamily="@font/inter" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="20"
                            app:trackColor="@color/bg_elevated"
                            app:indicatorColor="@color/bloom_5"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="20%"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_5"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- L6 Create -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="L6 Create"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_6"
                            android:fontFamily="@font/inter" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progress="8"
                            app:trackColor="@color/bg_elevated"
                            app:indicatorColor="@color/bloom_6"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:text="8%"
                            android:textSize="11sp"
                            android:textColor="@color/bloom_6"
                            android:fontFamily="@font/jetbrains_mono"
                            android:gravity="end" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Radar Chart Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_radar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skill Radar"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/space_grotesk"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/chart_radar"
                    android:layout_width="match_parent"
                    android:layout_height="260dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Learning Profile summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_learning_profile"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/space_grotesk"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_profile_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="6dp"
                    tools:text="You are strong in foundational recall and understanding. Focus areas: Application and Analysis. Kolb dominant style: Active Experimentation." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
