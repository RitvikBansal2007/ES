<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── TOP HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="56dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good evening 👋"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, Ritvik"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/space_grotesk"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="@color/accent_cyan"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/accent_cyan"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="R"
                        android:textSize="18sp"
                        android:textColor="@color/bg_primary"
                        android:fontFamily="@font/space_grotesk"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ── STREAK + QUICK STATS ROW ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp"
                android:weightSum="3">

                <!-- Streak -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_streak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_flame"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_streak_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textSize="22sp"
                            android:textColor="@color/accent_amber"
                            android:fontFamily="@font/space_grotesk"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_streak"
                            android:textSize="10sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sessions -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_sessions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📚"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tv_session_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24"
                            android:textSize="22sp"
                            android:textColor="@color/accent_teal"
                            android:fontFamily="@font/space_grotesk"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_sessions_completed"
                            android:textSize="10sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bloom Level -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_bloom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧠"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tv_bloom_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="L3"
                            android:textSize="22sp"
                            android:textColor="@color/bloom_3"
                            android:fontFamily="@font/space_grotesk"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bloom Level"
                            android:textSize="10sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/inter" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ── RTL STATUS CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_rtl_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <!-- Status dot -->
                    <ImageView
                        android:id="@+id/iv_rtl_status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_dot_online"
                        android:contentDescription="@null"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_rtl_lab"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/space_grotesk"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_rtl_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_simulator"
                            android:textSize="12sp"
                            android:textColor="@color/online_green"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Live data snippet -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tv_rtl_voltage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.00V"
                            android:textSize="16sp"
                            android:textColor="@color/accent_cyan"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voltage"
                            android:textSize="10sp"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/inter"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Open RTL button -->
                    <ImageButton
                        android:id="@+id/btn_open_rtl"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:src="@drawable/ic_progress"
                        android:tint="@color/accent_cyan"
                        android:contentDescription="Open RTL Live View"
                        android:layout_marginStart="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── TODAY'S PLAN — Kolb Stage ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_todays_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_todays_plan"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/space_grotesk"
                            android:textStyle="bold" />

                        <!-- Kolb Stage Pill -->
                        <TextView
                            android:id="@+id/tv_kolb_stage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LEARN"
                            android:textSize="11sp"
                            android:textColor="@color/kolb_ac"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@color/bg_elevated" />
                    </LinearLayout>

                    <!-- Plan description -->
                    <TextView
                        android:id="@+id/tv_plan_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Today you'll study RC Circuit theory and practice Bloom L3 application questions."
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="4dp" />

                    <!-- Progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:progress="60"
                        app:trackColor="@color/bg_elevated"
                        app:indicatorColor="@color/accent_teal"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60% complete"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/inter"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── WEAK TOPICS / FOCUS AREAS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_weak_topics"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/space_grotesk"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ll_topic_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Chips added programmatically -->
                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RC Transients"
                            android:textColor="@color/accent_amber"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            app:chipBackgroundColor="@color/bg_elevated"
                            app:chipStrokeColor="@color/accent_amber"
                            app:chipStrokeWidth="1dp"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Chip.Assist" />

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Impedance"
                            android:textColor="@color/accent_amber"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            app:chipBackgroundColor="@color/bg_elevated"
                            app:chipStrokeColor="@color/accent_amber"
                            app:chipStrokeWidth="1dp"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Chip.Assist" />

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thevenin's"
                            android:textColor="@color/accent_amber"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            app:chipBackgroundColor="@color/bg_elevated"
                            app:chipStrokeColor="@color/accent_amber"
                            app:chipStrokeWidth="1dp"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Chip.Assist" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ── QUICK ACTIONS ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_quick_chat"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/accent_cyan"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_chat"
                            android:tint="@color/accent_cyan"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ask AI"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_quick_quiz"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/accent_violet"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_quiz"
                            android:tint="@color/accent_violet"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick Quiz"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
