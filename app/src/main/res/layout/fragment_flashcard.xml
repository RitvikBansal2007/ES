<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.flashcard.FlashcardFragment">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/flashcard_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flashcards"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_card_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card 1 of 20"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/inter"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Kolb stage pill -->
        <TextView
            android:id="@+id/tv_kolb_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DO"
            android:textSize="11sp"
            android:textColor="@color/kolb_ce"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@color/bg_elevated" />
    </LinearLayout>

    <!-- Progress indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_flashcard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:progress="5"
        app:trackColor="@color/bg_elevated"
        app:indicatorColor="@color/accent_teal"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp"
        app:layout_constraintTop_toBottomOf="@+id/flashcard_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Flip Card Container (FrameLayout for front/back flip) -->
    <FrameLayout
        android:id="@+id/fl_card_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@+id/progress_flashcard"
        app:layout_constraintBottom_toTopOf="@+id/ll_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- FRONT face -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_teal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONCEPT"
                    android:textSize="10sp"
                    android:textColor="@color/accent_teal"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/tv_card_front"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/space_grotesk"
                    android:textStyle="bold"
                    android:lineSpacingExtra="6dp"
                    tools:text="What is the time constant τ of an RC circuit?" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_tap_to_flip"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="32dp"
                    android:alpha="0.6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BACK face (hidden initially) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_elevated"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANSWER"
                    android:textSize="10sp"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/tv_card_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="6dp"
                    tools:text="τ = RC where R is in Ohms and C in Farads. It represents the time for the voltage to reach ~63.2% of its final value." />

                <!-- Formula in mono -->
                <TextView
                    android:id="@+id/tv_formula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="τ = R × C"
                    android:textSize="20sp"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@color/bg_surface"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Difficulty Buttons (shown after flip) -->
    <LinearLayout
        android:id="@+id/ll_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:weightSum="3"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_hard"
            android:textColor="@color/bloom_5"
            android:fontFamily="@font/inter"
            app:strokeColor="@color/bloom_5"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_medium"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_medium"
            android:textColor="@color/bg_primary"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_amber"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_easy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_easy"
            android:textColor="@color/bg_primary"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_teal"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Tap to flip hint (when showing front) -->
    <LinearLayout
        android:id="@+id/ll_tap_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap card to reveal answer"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/inter" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
