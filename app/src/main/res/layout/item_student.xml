<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Avatar circle -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="@color/bg_elevated"
        app:cardElevation="0dp"
        app:strokeColor="@color/accent_teal"
        app:strokeWidth="1dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tv_student_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="S"
            android:textSize="16sp"
            android:textColor="@color/accent_teal"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_student_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Display Name"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_student_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@username"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/inter"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Joined date -->
    <TextView
        android:id="@+id/tv_student_joined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sep 2"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:fontFamily="@font/inter" />
</LinearLayout>
