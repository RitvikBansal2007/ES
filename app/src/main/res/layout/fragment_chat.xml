<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.chat.ChatFragment">

    <!-- ── TOP BAR ── -->
    <LinearLayout
        android:id="@+id/chat_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="52dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back / Menu -->
        <ImageButton
            android:id="@+id/btn_chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_home"
            android:tint="@color/text_secondary"
            android:contentDescription="Back"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Tutor"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/view_server_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/ic_dot_online"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/tv_server_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking server…"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/inter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kolb Stage Pill -->
        <TextView
            android:id="@+id/tv_kolb_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEARN"
            android:textSize="10sp"
            android:textColor="@color/kolb_ac"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@color/bg_elevated"
            android:layout_marginEnd="8dp" />

        <!-- Bloom indicator -->
        <TextView
            android:id="@+id/tv_bloom_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L3"
            android:textSize="10sp"
            android:textColor="@color/bloom_3"
            android:fontFamily="@font/jetbrains_mono"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@color/bg_elevated" />
    </LinearLayout>

    <!-- ── AI THINKING BANNER ── -->
    <LinearLayout
        android:id="@+id/layout_thinking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_thinking"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/chat_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_ai_thinking"
            android:textSize="11sp"
            android:textColor="@color/accent_violet"
            android:fontFamily="@font/jetbrains_mono"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_thinking_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/jetbrains_mono"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            tools:text="Analyzing the user's question... Identifying Bloom level 3..." />
    </LinearLayout>

    <!-- ── MESSAGES RECYCLER ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/layout_thinking"
        app:layout_constraintBottom_toTopOf="@+id/chat_bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── BOTTOM INPUT BAR ── -->
    <LinearLayout
        android:id="@+id/chat_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@color/bg_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mic button -->
        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_mic"
            android:src="@drawable/ic_mic"
            android:tint="@color/accent_teal"
            android:contentDescription="Voice input"
            android:padding="10dp"
            android:layout_marginEnd="8dp" />

        <!-- Message input -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_rounded"
            android:hint="@string/hint_message_input"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:imeOptions="actionSend"
            android:layout_marginEnd="8dp" />

        <!-- Send button -->
        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_send"
            android:src="@drawable/ic_send"
            android:tint="@color/bg_primary"
            android:contentDescription="@string/btn_send"
            android:padding="11dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
